{{#if resume.work}}
<section id="work" class="resume-section" aria-labelledby="work-heading">
  <h2 id="work-heading">{{i18n.sections.work}}</h2>
  {{#each resume.work}}
    <article class="item">
      <div class="item-topline">
        {{#with header}}{{> partials/item-header}}{{/with}}
        {{#with details}}{{> partials/item-details}}{{/with}}
      </div>
      {{#if description}}
        <div class="entry-meta">{{description}}</div>
      {{/if}}
      {{#if summary}}
        <div class="summary">
          <p>{{{summary}}}</p>
        </div>
      {{/if}}
      {{#if highlightGroups}}
        <div class="highlight-groups" aria-label="{{../i18n.labels.main_activities}}">
          <div class="highlight-groups-label">{{../i18n.labels.main_activities}}:</div>
          {{#each highlightGroups}}
            <div class="highlight-group">
              {{#if title}}
                <div class="highlight-group-title">{{title}}</div>
              {{/if}}
              {{#if items}}
                <ul class="highlights highlight-group-items">
                  {{#each items}}
                    <li><span class="list-bullet">• </span><span class="list-text">{{{this}}}</span></li>
                  {{/each}}
                </ul>
              {{/if}}
            </div>
          {{/each}}
        </div>
      {{/if}}
      {{#if highlights}}
        <ul class="highlights">
          {{#each highlights}}
            <li><span class="list-bullet">• </span><span class="list-text">{{{this}}}</span></li>
          {{/each}}
        </ul>
      {{/if}}
    </article>
  {{/each}}
</section>
{{/if}}
